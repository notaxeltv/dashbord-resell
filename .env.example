# Obbligatorie in locale (le stesse di Vercel / Supabase → Settings → API).
# Senza queste `npm run dev` reindirizza a /env-mancante.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# --- Notifiche automatiche (opzionali) ---
# Se non configurate, l'app funziona normalmente senza inviare notifiche.
# Vedi README per le istruzioni di setup.

# Telegram: crea un bot con @BotFather su Telegram per ottenere il token.
# Ogni persona deve scrivere al bot almeno una volta, poi
# https://api.telegram.org/bot<TOKEN>/getUpdates mostra il suo chat_id.
# Più destinatari: separa gli id con una virgola.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp (via Twilio): crea un account su twilio.com, attiva la WhatsApp
# Sandbox (Messaging > Try it out > Send a WhatsApp message) e usa le
# credenziali del tuo account.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+391234567890"

# Immagini carte (opzionale): token API di CardTrader (https://api.cardtrader.com),
# usato SOLO lato server per recuperare l'immagine di una carta in base a
# nome e set. NON deve mai iniziare con NEXT_PUBLIC_ e non va mai condiviso
# pubblicamente. Vedi README per come ottenerlo.
CARDTRADER_API_TOKEN=""

# Chiavi email per cancellare il registro.
# GMAIL_APP_PASSWORD è la password per le app di Google (non la password di accesso).
# REGISTRO_EMAILS: le due email che ricevono le chiavi, separate da virgola.
# Se vuoto, usa le email dei due profili Supabase.
GMAIL_USER="darkghost.cards@gmail.com"
GMAIL_APP_PASSWORD=""
REGISTRO_EMAILS=""
REGISTRO_CODE_PEPPER=""

# Digest giornaliero (opzionale): riepilogo automatico di carte/lotti/vendite
# delle ultime 24 ore, inviato una volta al giorno via Telegram/WhatsApp
# (richiede che almeno uno dei due sia configurato sopra).
# CRON_SECRET: stringa a caso generata da te (es. `openssl rand -hex 32`).
# Vai su Vercel → Project → Settings → Environment Variables, imposta la
# stessa stringa: Vercel la invia in automatico come header Authorization
# quando chiama la rotta pianificata in vercel.json.
CRON_SECRET=""
# SUPABASE_SERVICE_ROLE_KEY: da Supabase → Settings → API → service_role.
# Serve SOLO alla rotta del digest per leggere i dati senza una sessione
# utente. Non deve MAI iniziare con NEXT_PUBLIC_ e non va mai esposta al
# browser: usala solo come variabile d'ambiente server-side su Vercel.
SUPABASE_SERVICE_ROLE_KEY=""
