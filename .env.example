# Obbligatorie in locale (le stesse di Vercel / Supabase → Settings → API).
# Senza queste `npm run dev` reindirizza a /env-mancante.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# --- Notifiche automatiche (opzionali) ---
# Se non configurate, l'app funziona normalmente senza inviare notifiche.
# Vedi README per le istruzioni di setup.

# Telegram: crea un bot con @BotFather su Telegram per ottenere il token,
# poi scrivi al bot e usa https://api.telegram.org/bot<TOKEN>/getUpdates
# per recuperare il tuo chat_id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# WhatsApp (via Twilio): crea un account su twilio.com, attiva la WhatsApp
# Sandbox (Messaging > Try it out > Send a WhatsApp message) e usa le
# credenziali del tuo account.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="whatsapp:+391234567890"

# Immagini carte (opzionale): token API di CardTrader (https://api.cardtrader.com),
# usato SOLO lato server per recuperare l'immagine di una carta in base a
# nome e set. NON deve mai iniziare con NEXT_PUBLIC_ e non va mai condiviso
# pubblicamente. Vedi README per come ottenerlo.
CARDTRADER_API_TOKEN=""

# Chiavi email per cancellare il registro (opzionali ma necessarie per eliminare).
# Resend: https://resend.com — REGISTRO_EMAIL_FROM deve essere un mittente verificato.
# REGISTRO_EMAILS: le due email del team, separate da virgola. Se vuoto, usa i due profili.
RESEND_API_KEY=""
REGISTRO_EMAIL_FROM="Dark Ghost Cards <registro@tuodominio.com>"
REGISTRO_EMAILS=""
REGISTRO_CODE_PEPPER=""
